{
  "name": "xsos-web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "engines": {
    "node": ">=26.7.0 <27"
  },
  "scripts": {
    "dev": "python3 ../scripts/build-leptos.py build --debug && vite",
    "test:unit": "npm run test:leptos",
    "test:account:live": "node tests/account-settings-live.mjs",
    "check:xcss": "node scripts/check-xcss-toolchain.mjs",
    "build": "npm run check:xcss && python3 ../scripts/build-leptos.py build && vite build",
    "preview": "vite preview",
    "test:browser": "npm run build && node tests/browser-acceptance.mjs && node tests/instances.mjs && node tests/account-settings.mjs && node tests/leptos-transport.mjs",
    "build:leptos": "npm run build",
    "check:leptos": "python3 ../scripts/build-leptos.py check",
    "test:leptos": "python3 ../scripts/build-leptos.py test",
    "test:browser:leptos": "npm run test:browser"
  },
  "dependencies": {
    "@xcss/web": "https://github.com/isarmg/xcss/releases/download/v1.0.0/xcss-web-1.0.0.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "vite": "8.3.3"
  }
}
